ENV=development
DEBUG=false

# DB connection metadata (non-sensitive)
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth
AUTH_DB_USER=auth_rw

LISTING_DB_HOST=listing-db
LISTING_DB_PORT=5432
LISTING_DB_NAME=listings
